---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import Experience from "@/components/Experience.astro"
import Education from "@/components/Education.astro"
import TechStack from "@/components/TechStack.astro"
import School from "@/components/icons/School.astro"
import UserHeart from "@/components/icons/UserHeart.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
---

<Layout
  title="Porfolio de Carlos Daniel - Desarrollador Fullstack"
  description="Porfolio de Carlos Daniel Hilario Gomez, Desarrollador Fullstack especializado en Angular y Spring Boot."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-28">
      <Hero />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="sobre-mi">
        <TitleSection color="from-blue-500/80">
          <UserHeart class="size-8 text-blue-500 dark:text-blue-400" />
          Sobre mí
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer>
        <TechStack />
      </SectionContainer>

      <SectionContainer id="experiencia">
        <TitleSection color="from-sky-500/60">
          <Briefcase class="size-8 text-sky-500 dark:text-sky-600" />
          Experiencia laboral
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="educacion">
        <TitleSection color="from-indigo-500/70">
          <School class="size-8 text-indigo-500 dark:text-indigo-400" />
          Educación
        </TitleSection>
        <Education />
      </SectionContainer>
    </div>
  </main>
</Layout>
