---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Educación",
    label: "educacion",
    url: "/#educacion",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "mailto:dantechnologi@gmail.com",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full text-gray-600 dark:text-gray-300 justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-sky-500 dark:hover:text-sky-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <div class="ml-2 pl-2 border-l border-gray-300/30 dark:border-white/10">
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const sectionColorMap: Record<string, { text: string; bg: string }> = {
      "sobre-mi": { text: "text-blue-500 dark:text-blue-400", bg: "bg-blue-500/10" },
      "experiencia": { text: "text-sky-500 dark:text-sky-600", bg: "bg-sky-500/10" },
      "educacion": { text: "text-indigo-500 dark:text-indigo-400", bg: "bg-indigo-500/10" },
    }

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            const label = item.getAttribute("aria-label")
            const colors = label && sectionColorMap[label] ? sectionColorMap[label] : { text: "text-slate-400 dark:text-slate-300", bg: "bg-slate-400/10" }
            const activeClasses = [...colors.text.split(" "), colors.bg]
            const allActiveClasses = [
              "text-blue-500", "dark:text-blue-400", "bg-blue-500/10",
              "text-slate-400", "dark:text-slate-300", "bg-slate-400/10",
              "text-sky-500", "dark:text-sky-400", "bg-sky-400/10",
              "text-emerald-500", "dark:text-emerald-400", "bg-emerald-400/10",
              "text-violet-500", "dark:text-violet-400", "bg-violet-400/10",
            ]

            if (label == entry.target.id) {
              item.classList.remove(...allActiveClasses, "text-gray-600", "dark:text-gray-300")
              item.classList.add(...activeClasses)
            } else {
              item.classList.remove(...allActiveClasses)
              item.classList.add("text-gray-600", "dark:text-gray-300")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .header-nav {
    @apply dark:bg-gray-900/80 bg-white/60;
  }

  .nav-link.text-sky-500 {
    @apply font-semibold;
  }

  @keyframes nav-appear {
    0% {
      @apply dark:bg-gray-900/0 bg-white/0 border-transparent shadow-none;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur-md ring-white/10 dark:ring-white/5 border-gray-200/20 dark:border-white/5;
    }
  }
</style>
